#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the yaml-test-suite against every configured parser and reports where
# they disagree with the suite and with each other.
#
# Usage:
#   bin/conform                          every parser, every case
#   bin/conform --only psych,js-yaml     just these
#   bin/conform --case '4MUZ|DK95'       just cases matching this regex
#   bin/conform --values                 score event streams and loaded values
#   bin/conform --matrix-only            the Psych version matrix and its baseline
#   bin/conform --list                   what parsers are configured
#   bin/conform --custom-only            just the local cases in data/custom_cases/
#   bin/conform --no-custom              skip them
#   bin/conform --no-report              terminal only, write no files
#
# Exit status is 0 when the run completed, 1 when a parser could not be run at
# all. A parser failing test cases is a result, not an error, so it does not
# change the exit status -- use the JSON report if CI needs to gate on counts.

require 'optparse'

$LOAD_PATH.unshift(File.expand_path('../lib', __dir__))

require 'config'
require 'suite'
require 'parsers'
require 'runner'
require 'report'
require 'case_report'
require 'custom_cases'
require 'custom_report'

options = {
  only: nil,
  case_filter: nil,
  write_reports: true,
  matrix: true,
  score: %i[events],
  agreement: true,
  custom: true
}

OptionParser.new do |o|
  o.banner = 'usage: bin/conform [options]'

  o.on('--only LIST', 'comma-separated parser ids to run') do |v|
    options[:only] = v.split(',').map(&:strip)
  end
  o.on('--matrix-only', 'just the Psych version matrix, plus the baseline it varies from') do
    options[:only] = Parsers::MATRIX_SET.dup
  end
  o.on('--no-agreement', 'skip the pairwise agreement tables') { options[:agreement] = false }
  o.on('--values', 'also score loaded values against the suite json:') do
    options[:score] = %i[events value]
  end
  o.on('--values-only', 'score loaded values instead of event streams') do
    options[:score] = %i[value]
  end
  o.on('--case REGEX', 'only cases whose id matches') { |v| options[:case_filter] = v }
  o.on('--no-custom', "skip the local cases in data/custom_cases/") { options[:custom] = false }
  o.on('--custom-only', 'run only the local cases in data/custom_cases/') do
    options[:custom] = true
    options[:custom_only] = true
  end
  o.on('--no-report', 'skip writing report files') { options[:write_reports] = false }
  o.on('--no-matrix', 'skip the per-case matrix in terminal output') { options[:matrix] = false }
  o.on('--out DIR', 'where to write reports') { |v| Config.send(:remove_const, :REPORT_DIR); Config.const_set(:REPORT_DIR, v) }
  o.on('--list', 'list configured parsers and exit') do
    { 'parsers' => Parsers::BASE, 'psych version matrix' => Parsers::MATRIX }.each do |heading, group|
      puts "#{heading}:"
      group.each do |id, spec|
        puts format('  %-14s %-30s %-8s %s', id, spec[:label], spec[:lang], spec[:note])
      end
      puts
    end
    exit 0
  end
  o.on('-h', '--help') { puts o; exit 0 }
end.parse!

parsers = begin
  Parsers.resolve(options[:only])
rescue ArgumentError => e
  abort "error: #{e.message}"
end

# --custom-only skips the suite entirely, checkout and all. The point of the
# flag is a fast loop while adding a local case, and cloning 350 files to then
# not read them would defeat it.
cases =
  if options[:custom_only]
    []
  else
    begin
      Suite.cases(filter: options[:case_filter])
    rescue Suite::Error => e
      abort "error: #{e.message}"
    end
  end

custom_cases = options[:custom] ? CustomCases.cases(filter: options[:case_filter]) : []

if options[:custom_only]
  abort "error: no cases in #{CustomCases::DIR.sub("#{Config::ROOT}/", '')}" if custom_cases.empty?
else
  abort 'error: no cases matched' if cases.empty?
end

unless cases.empty?
  warn "running #{cases.size} cases against #{parsers.size} parser(s)"
end

# Each mode is a separate run over the same cases, reported separately. They
# answer different questions -- what the parser built, versus what the library
# resolved that into -- and averaging them would describe neither.
MODES = {
  events: {
    title: 'event streams (the suite\'s tree:)',
    blurb: 'what the parser built, compared against the expected event stream'
  },
  value: {
    title: 'loaded values (the suite\'s json:)',
    blurb: 'what the library resolved that into, compared against the expected JSON'
  }
}.freeze

runs = []
failed_parsers = []

options[:score].each do |mode|
  next if cases.empty?

  eligible = parsers.select { |n| mode == :events || Parsers[n][:value] }

  if eligible.empty?
    warn "skipping the #{mode} run: no selected parser can score it"
    next
  end

  # The value run only scores cases the suite states a json: for. Counting the
  # rest as passes would inflate every parser by the same ~130 cases and make
  # the two runs look closer than they are.
  mode_cases = mode == :value ? cases.select { |c| c.value? || c.error? } : cases

  puts
  puts "#{MODES[mode][:title]} — #{eligible.size} parser(s), #{mode_cases.size} cases"

  started = Time.now
  results = []
  versions = {}

  eligible.each do |name|
    spec = Parsers[name]
    print format('  %-22s ', spec[:label])
    $stdout.flush

    begin
      versions[name] = Runner.version(name)
      done = 0
      rows = Runner.run(name, mode_cases, mode: mode) do |_r|
        done += 1
        # A dot per 25 cases keeps the line short but shows the run is alive.
        if (done % 25).zero?
          print '.'
          $stdout.flush
        end
      end
      results.concat(rows)
      puts format(' %d/%d', rows.count(&:pass?), mode_cases.size)
    rescue Docker::Error => e
      puts ' SKIPPED'
      warn "    #{e.message.lines.first.to_s.strip}"
      failed_parsers << name
    end
  end

  ran = eligible - failed_parsers
  next if ran.empty?

  runs << Report::Run.new(
    results: results,
    parsers: ran,
    versions: versions,
    case_count: mode_cases.size,
    started_at: started,
    finished_at: Time.now,
    suite_ref: Config::SUITE_REF,
    mode: mode,
    title: MODES[mode][:title],
    cases: mode_cases
  )
end

abort 'error: no parser could be run' if runs.empty? && !options[:custom_only]

runs.each do |run|
  puts
  puts "== #{run.title}"
  puts "   #{MODES[run.mode][:blurb]}"
  Report.terminal(run, matrix: options[:matrix])
  Report.terminal_agreement(run) if options[:agreement] && run.parsers.size > 1
end

# --- the local corpus -------------------------------------------------------
#
# Run after the scored runs and kept out of `runs` entirely. These documents
# carry no expectation (see lib/custom_cases.rb), so there is nothing to score
# them against -- they get their own probe, their own terminal section, and
# their own directory under reports/. Nothing here can move a pass rate, which
# is the whole reason the corpus is separate.
probes = []

unless custom_cases.empty?
  puts
  puts "custom cases — #{custom_cases.size} local document(s), unscored"

  options[:score].each do |mode|
    eligible = parsers.select { |n| mode == :events || Parsers[n][:value] } - failed_parsers
    next if eligible.empty?

    puts
    puts "  #{CustomReport::MODE_TITLE[mode]} — #{CustomReport::MODE_BLURB[mode].downcase}"

    started = Time.now
    observations = []
    versions = {}
    ran = []

    eligible.each do |name|
      spec = Parsers[name]
      print format('    %-22s ', spec[:label])
      $stdout.flush

      begin
        versions[name] = Runner.version(name)
        seen = Runner.probe(name, custom_cases, mode: mode)
        observations.concat(seen.values)
        ran << name
        parsed = seen.values.count(&:ok?)
        puts format(' %d parsed, %d rejected', parsed, seen.size - parsed)
      rescue Docker::Error => e
        puts ' SKIPPED'
        warn "      #{e.message.lines.first.to_s.strip}"
        failed_parsers << name
      end
    end

    next if ran.empty?

    probes << CustomReport::Probe.new(
      observations: observations,
      parsers: ran,
      versions: versions,
      cases: custom_cases,
      mode: mode,
      started_at: started,
      finished_at: Time.now
    )
  end

  # A per-case summary rather than a per-parser one. With no expectation there
  # is no column to total, so what the terminal can usefully say is how many
  # ways the field split on each document.
  probes.each do |probe|
    puts
    puts "== custom cases: #{CustomReport::MODE_TITLE[probe.mode].downcase}"
    puts
    probe.case_ids.each do |id|
      camps = probe.camps(id)
      # Report.camp_label names a camp by the first thing it produced that the
      # other camps did not, so two camps that both parsed are told apart.
      # "parsed: 3 | parsed: 1" would be a line that reports a disagreement
      # without saying what it is about.
      groups = camps.sort_by { |_, ps| [-ps.size, ps.first] }.map do |out, ps|
        "#{Report.camp_label(out, camps)}: #{ps.size}"
      end
      puts format('   %-28s %d camp%s   %s', id, camps.size,
                  camps.size == 1 ? ' ' : 's', groups.join('  |  '))
    end
    puts
  end
end

abort 'error: no parser could be run' if runs.empty? && probes.empty?

if options[:write_reports]
  runs.each do |run|
    suffix = runs.size > 1 ? "-#{run.mode}" : nil
    paths = Report.write_all(run, suffix: suffix)
    puts "wrote (#{run.mode}):"
    paths.each_value { |p| puts "  #{p.sub("#{Config::ROOT}/", '')}" }
  end

  # Written from every run at once rather than once per mode: a case file holds
  # both scores, so the event and value runs would otherwise overwrite each
  # other's half.
  unless runs.empty?
    written = CaseReport.write_all(runs)
    puts "wrote #{written.size} case file(s):"
    puts "  #{File.join(Config::REPORT_DIR, 'cases').sub("#{Config::ROOT}/", '')}/"
  end

  # Its own directory, written from every mode at once for the same reason the
  # scored case files are: a custom case's page holds both the events and the
  # values it produced, and one mode writing alone would drop the other half.
  unless probes.empty?
    made = CustomReport.write_all(probes)
    puts "wrote #{made.size} custom case file(s):"
    puts "  #{File.join(Config::REPORT_DIR, CustomReport::DIRNAME).sub("#{Config::ROOT}/", '')}/"
  end
end

exit(failed_parsers.empty? ? 0 : 1)
